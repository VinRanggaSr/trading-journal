# Copy file ini jadi ".env" (tanpa .example) untuk development lokal.
# Isi nilai asli di file .env kamu - JANGAN commit file .env ke git.

# Password buat login ke aplikasi (bebas kamu tentukan sendiri)
APP_PASSWORD=ganti_dengan_password_kamu

# String random buat nandatangani session token - beda dari APP_PASSWORD,
# beda juga dari APPS_SCRIPT_SECRET. Generate random string yang panjang.
SESSION_SECRET=ganti_dengan_string_random_panjang_banget

# Web App URL dari Step 1 (Apps Script) - formatnya:
# https://script.google.com/macros/s/XXXXXXXXXXXX/exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# Harus SAMA PERSIS dengan SHARED_SECRET yang ada di Code.gs (Step 1)
APPS_SCRIPT_SECRET=journaltradebagger100x
